          "label": "Opening times",
          "viewport": {
            "width": 560,
            "height": 540
          }
        }
      }
    },
    "brand": {
      "source": {
        "module": "src/components/SiteLayout.tsx",
        "export": "Brand"
      },
      "label": "Casa Espina brand",
      "description": "Shared cactus mark and wordmark linking to the homepage.",
      "category": "Brand",
