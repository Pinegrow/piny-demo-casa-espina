    "ticket-quantity": {
      "source": {
        "module": "src/components/TicketQuantity.tsx",
        "export": "TicketQuantity"
      },
      "label": "Ticket quantity",
      "description": "Ticket type, price and quantity control.",
      "category": "Booking controls",
      "documentation": "README.md",
      "visibility": "advanced",
      "props": {
        "label": {
          "label": "Ticket label",
          "control": "text",
          "group": "Content"
        },
        "detail": {
          "label": "Ticket details",
          "control": "textarea",
          "group": "Content"
        },
        "price": {
          "label": "Unit price (EUR)",
          "control": "number",
          "group": "Booking",
          "readOnly": true,
          "description": "Owned by the booking price configuration."
        },
        "value": {
          "label": "Selected quantity",
          "control": "number",
          "group": "Booking",
          "readOnly": true,
          "description": "Owned by React booking state."
        },
        "minimum": {
          "label": "Minimum quantity",
          "control": "number",
          "group": "Booking",
          "min": 0,
          "max": 8,
          "step": 1
        }
      },
      "examples": {
        "default": {
          "html": ".piny/previews/ticket-adults.html",
          "label": "Two adults",
          "viewport": {
            "width": 620,
            "height": 200
          }
        },
        "minimum": {
          "html": ".piny/previews/ticket-children.html",
          "label": "No children selected",
          "viewport": {
            "width": 620,
            "height": 200
          }
        }
      },
      "watch": {
        "preview": [
          "src/booking.ts",
          "src/pages/TicketsPage.tsx"
        ]
      }
    }
  }
